# Продакшн-домен сайту. Використовується для metadataBase, hreflang alternates,
# sitemap.xml та robots.txt (src/lib/constants.ts). Без цього фолбек — http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Перемикач preview/production для індексації пошуковиками (src/lib/constants.ts →
# IS_PREVIEW_ENV). Значення "preview" вимикає індексацію повністю: robots.txt віддає
# Disallow: / для всіх user-agent (src/app/robots.ts), а кожна сторінка отримує
# <meta name="robots" content="noindex,nofollow"> (src/app/[locale]/layout.tsx).
# Поставити на Vercel в Environment Variables лише для деплоїв на тимчасовому
# *.vercel.app домені. Коли сайт переїде на постійний домен — прибрати цю змінну
# або виставити "production", і noindex зникне без правок коду.
NEXT_PUBLIC_SITE_ENV=

# GA4 Measurement ID (напр. G-XXXXXXXXXX). Поки не задано — Analytics залишається заглушкою
# (src/components/Analytics/Analytics.tsx), реальне підключення + Google Consent Mode v2 — окремий крок.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Код підтвердження власності сайту в Google Search Console (meta-тег verification).
# Ще не підключено в коді — додати в metadata.verification.google, коли буде значення.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
